# Database Connection
DEFAULT_CONNECTION=Host=localhost;Port=5432;Database=mylife_db;Username=postgres;Password=postgres

# JWT Secrets
JWT_KEY=your_very_long_secret_key_at_least_32_characters_here
JWT_ISSUER=MyLifeApp
JWT_AUDIENCE=MyLifeAppUsers
JWT_EXPIRY_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email notification / SMTP (for the Mobile "send test" action)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@gmail.com
SMTP_USE_SSL=true

# LINE Messaging API (for the Mobile "send test" action)
LINE_MESSAGING_API_URL=https://api.line.me/v2/bot
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# Service API Key (For background workers / cron)
SERVICE_API_KEY=your_service_api_key

# Background Workers
ENABLE_BACKEND_REMINDER_WORKER=true

# Oracle Cloud Infrastructure (OCI) Object Storage
OCI_S3_ACCESS_KEY=your_oci_customer_secret_access_key
OCI_S3_SECRET_KEY=your_oci_customer_secret_key
OCI_REGION=ap-singapore-1
OCI_NAMESPACE=your_tenancy_namespace
OCI_BUCKET_NAME=mylife-profile-bucket
# Optional: Set public URL base if your bucket has public read visibility
# OCI_PUBLIC_URL_BASE=https://objectstorage.ap-singapore-1.oraclecloud.com/n/your_namespace/b/mylife-profile-bucket/o
